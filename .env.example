# --- Architecture Intelligence service (Python / LangGraph) ---
# Base URL of the FastAPI service that hosts the Architecture Agent and Scene Agent.
ARCHITECTURE_SERVICE_URL=http://127.0.0.1:8000

# --- OpenRouter (model provider for all agents) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default reasoning model used by the Architecture Agent.
OPENROUTER_ARCHITECTURE_MODEL=z-ai/glm-5.3-flash
# Default model used by the Scene Agent (scene composition).
OPENROUTER_SCENE_MODEL=z-ai/glm-5.3-flash
# Optional attribution headers required by OpenRouter for some accounts.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=architecture-to-3d-world

# --- GitHub (optional) ---
# Public repos work without a token (60 req/hour). A token raises it to 5000/hour.
# A classic token with NO scopes is sufficient for public repositories.
GITHUB_TOKEN=

# --- Image generation (optional) ---
# Generates landmark art through the asset provider chain. Uses the SAME
# OPENROUTER_API_KEY above, so no extra key is needed.
#   IMAGE_PROVIDER=openrouter  -> OpenRouter image models (default)
#   IMAGE_PROVIDER=gemini      -> Google API directly (needs GOOGLE_API_KEY)
#   IMAGE_PROVIDER=none        -> disabled; the chain falls through to procedural art
IMAGE_PROVIDER=openrouter
# Google Nano Banana 2 (Gemini 3.1 Flash Image) via OpenRouter.
IMAGE_MODEL=google/gemini-3.1-flash-image
